{
  "schemaVersion": 1,
  "id": "supermodmenu",
  "version": "${version}",
  "name": "Mod Menu Pro",
  "description": "A polished mod manager for Fabric with search, favorites, notes, dependency insights, update checks, and an in-game Modrinth browser. Built for Minecraft 26.2.",
  "authors": ["Kamlesh Choudhary"],
  "contact": {
    "homepage": "https://devxkamlesh.com",
    "sources": "https://github.com/devxkamlesh/supermodmenu",
    "issues": "https://github.com/devxkamlesh/supermodmenu/issues"
  },
  "license": "MIT",
  "icon": "assets/supermodmenu/icon.png",
  "environment": "client",
    "entrypoints": {
      "client": [
        "com.supermodmenu.SuperModMenuClient"
      ]
    },
  "mixins": [
    "supermodmenu.mixins.json"
  ],
    "depends": {
      "fabricloader": ">=0.19.3",
      "fabric-api": "*",
      "minecraft": "26.2",
      "java": ">=25"
    }
}
