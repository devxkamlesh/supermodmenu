{
  "schemaVersion": 1,
  "id": "supermodmenu",
  "version": "${version}",
  "name": "Super Mod Menu",
  "description": "A focused, modern mod menu for Fabric: in-game Modrinth browser, hash-based update checker with one-click updates, rich detail panel, favorites, notes, and dependency insight.",
  "authors": ["Kamlesh Choudhary"],
  "contact": {
    "homepage": "https://devxkamlesh.com",
    "sources": "https://github.com/devxkamlesh/supermodmenu",
    "issues": "https://github.com/devxkamlesh/supermodmenu/issues"
  },
  "license": "MIT",
  "icon": "assets/supermodmenu/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.supermodmenu.SuperModMenuClient"
    ]
  },
  "mixins": [
    "supermodmenu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.5"
  }
}
